{
  "name": "brandy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "guard": "bun scripts/guard.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate-auth": "bunx @better-auth/cli@latest generate --output src/features/auth/schema.ts --config src/features/auth/server/better-auth.ts --yes",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/server/seed/index.ts",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@mantine/core": "^9.6.2",
    "@mantine/dropzone": "^9.6.2",
    "@mantine/form": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@mantine/notifications": "^9.6.2",
    "@orpc/client": "^1.15.3",
    "@orpc/react-query": "^1.15.3",
    "@orpc/server": "^1.15.3",
    "@orpc/zod": "^1.15.3",
    "@tabler/icons-react": "^3.47.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "8.20.5",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "mantine-form-zod-resolver": "^1.3.0",
    "next": "16.3.5",
    "nuqs": "^2.10.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-idle-timer": "^5.7.3",
    "zod": "3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.1.14",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
